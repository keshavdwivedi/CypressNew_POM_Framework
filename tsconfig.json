{
  "compilerOptions": {
    "target": "es6",
    "lib": ["ES6", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
     "sourceMap": true,
    "types": ["cypress", "node"]
  },
  "include": ["**/*.ts","**/*.d.ts","cypress/**/*.ts"]
}
