{
  "name": "cypress_pom",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
     "clean": "rimraf cypress/reports cypress/screenshots cypress/videos",
     "cy:open": "cypress open",

     "cy:run": "cypress run",
     "cy:run:headed": "cypress run --headed",
     "cy:run:chrome": "cypress run --browser chrome",
     "cy:run:chrome:headed": "cypress run --browser chrome --headed",

      "test": "npm run clean && npm run cy:run:chrome",
      "test:headed": "npm run clean && npm run cy:run:chrome:headed",

      "test:spec": "npm run clean && cypress run --spec cypress/e2e/**/*.cy.spec.ts",  
      "test:chrome":"npm run clean && npm run cy:run:chrome",
      "report:run": "npm run clean && cypress run --reporter cypress-mochawesome-reporter --reporter-options reportDir=cypress/reports/mochareports,charts=true,overwrite=true,html=true,json=true",

      "tagtesting": "npx cypress run -e TAGS=\"@E2ENaveenAutomationLabs\" --e2e --browser chrome  --headed"
       
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com:keshavdwivedi/CypressNew_POM_Framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/keshavdwivedi/CypressPageObjectModel/issues"
  },
  "homepage": "https://github.com/keshavdwivedi/CypressPageObjectModel#readme",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "cypress": "^15.9.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unique-names-generator": "^4.7.1",
    "rimraf":"^6.1.2"
  }
}
